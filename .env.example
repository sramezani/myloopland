# myloopland environment variables (docs/SPEC.md section 10).
# Copy to .env for local development. For production, deploy/setup.sh builds
# deploy/secrets/app.env from this file (docs/deploy.md); the server keeps a copy.
# Never commit real values. src/lib/env.ts checks them with Zod when the server starts.

# ── App ───────────────────────────────────────────────────────────────
# Absolute base URL: links, the Google callback and the MCP address Claude connects to
# (<APP_URL>/mcp). Local: http://localhost:3000 · Production: https://myloopland.com (or your own domain)
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────
# Postgres. Local (docker compose up -d db): postgres://myloopland:myloopland@localhost:5433/myloopland
# Any Postgres you own works; remote hosts get TLS. Percent-encode special characters in the
# password (for example @ becomes %40).
# On the server, deploy/compose.yaml sets it from POSTGRES_PASSWORD, so app.env leaves it out.
DATABASE_URL=postgres://myloopland:myloopland@localhost:5433/myloopland
# Server only: the password of the Postgres container (letters and digits). Set once, by
# deploy/setup.sh; changing it later locks the app out of the existing database.
POSTGRES_PASSWORD=

# ── Sign-in (Better Auth + Google) ───────────────────────────────────
# Signs sessions and Claude's tokens. 32+ random characters:
#   openssl rand -base64 48
# Changing it signs everyone out, and every Claude connection must sign in again.
BETTER_AUTH_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI: <APP_URL>/api/auth/callback/google (add the localhost one for development).
# Only the basic sign-in scopes are used (openid, email, profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Backups (the backup helper container on the server, not the app) ──
# See docs/deploy.md. Database to dump: on the server, deploy/compose.yaml sets it.
BACKUP_DATABASE_URL=
# Cloudflare R2. Only the 32-character account ID (Cloudflare → R2 → Overview), not the full
# https:// address. All four empty: no nightly backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
